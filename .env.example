# Optional. The app starts and works without a .env file.
# Point this at a LibreTranslate-compatible server (for example a self-hosted
# IndicTrans2 wrapper). Leave empty to use the free keyless MyMemory endpoint.
VITE_TRANSLATE_API_URL=
# Only needed if your translation server requires a key. This value is built into the
# browser bundle, so use it for prototypes only, never for a real secret.
VITE_TRANSLATE_API_KEY=
